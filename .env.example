# Public Sanity config (safe to expose; also hardcoded in astro.config.mjs +
# src/lib/sanityClient.js — keep in sync if the project ever moves)
PUBLIC_SANITY_PROJECT_ID=b60h4u7o
PUBLIC_SANITY_DATASET=production

# ── Secrets (put real values in .env.local, never commit them) ──
# Sanity token with write access — used by ingestion/migration scripts only,
# not by the site build.
SANITY_WRITE_TOKEN=

# Mux API credentials — used by video ingestion scripts only.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
