---
/**
 * BaseLayout — HTML document shell.
 *
 * Handles: charset, viewport, meta, fonts, favicon,
 * Netlify hidden form, global CSS, and the persistent SiteShell.
 *
 * The SiteShell (nav + drawer + overlay) uses `transition:persist`
 * so it survives page navigations without reloading state.
 * ClientRouter enables SPA-like client-side navigation.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// A2b Lenis scroll-tuning bench styles — only the .lenis-tune tree, which
// renders solely under ?lenistune=1 (LenisTunePanel), is styled; inert otherwise.
import '../styles/lenis-tune.css';
// Home-hero rig-tuning bench styles — only the .hero-tune tree, which
// renders solely under ?herotune=1 (HeroTunePanel), is styled; inert otherwise.
import '../styles/hero-tune.css';
import SiteShell from '../components/SiteShell.jsx';
// ?url imports resolve to the same content-hashed asset the CSS @font-face
// references, so these preloads hit the real built URLs.
import fontBook from '../assets/fonts/PPNeueMontreal-Book.woff2?url';
import fontMedium from '../assets/fonts/PPNeueMontreal-Medium.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Social share image path (1200×630); defaults to the site card. */
  image?: string;
}

const {
  title = 'Small World Media™',
  description = 'Small World Media — Visual worlds for the music industry. Multi-disciplinary creative studio specializing in visual identity, motion design, and digital experiences.',
  image = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Globe-page chrome variant (transparent nav, black info pill) keys off this
// body class. Set server-side so there's no hydration flash; the ClientRouter
// swaps body attributes on navigation, so leaving `/` restores the blue nav.
const isHome = Astro.url.pathname === '/';
// Process-page chrome variant (transparent nav over the brand-black field)
// + the route's scroll unlock key off this one — same server-side rule.
const isProcess = Astro.url.pathname.replace(/\/+$/, '') === '/process';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#000000" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Social cards */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Small World Media" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Client-side navigation — SPA-like page swaps */}
    <ClientRouter />

    {/* Brand faces used above the fold — preload beats the CSS discovery */}
    <link rel="preload" href={fontBook} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontMedium} as="font" type="font/woff2" crossorigin />

    {/* Mux — warm DNS+TLS+TCP before the first globe manifest / still / work thumbnail (both fetched with CORS) */}
    <link rel="preconnect" href="https://stream.mux.com" crossorigin />
    <link rel="preconnect" href="https://image.mux.com" crossorigin />

    {/* Google Fonts: Inter (UI font stack) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* Favicons */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  </head>

  <body class:list={[isHome && 'route-home', isProcess && 'route-process']}>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* Hidden form for Netlify's deploy parser (SPA detection) — field set
        must mirror ProjectOverlay's live form or Netlify drops fields */}
    <form name="contact" netlify netlify-honeypot="bot-field" hidden>
      <input name="bot-field" />
      <input name="name" />
      <input name="email" />
      <input name="project" />
      <input name="subject" />
      <input name="replyto" />
      <textarea name="message"></textarea>
    </form>

    {/* Persistent shell — nav + drawer + overlay (survives page swaps) */}
    <SiteShell client:load transition:persist="site-shell" transition:animate="none" />

    <div id="main">
      <slot />
    </div>

    {/* Lenis smooth scroll — per-route start/stop (off on /work + reduced motion) */}
    <script>
      import { syncRoute } from '../lib/smoothScroll.js';
      document.addEventListener('astro:page-load', () => syncRoute());

      // Arm the /work return-restore for browser back/forward out of a
      // detail page. `route` lags one navigation behind (astro:page-load
      // hasn't fired yet when popstate lands), so it identifies the page
      // being LEFT while location already points at the destination —
      // the flag arms only for detail → /work traversals. The detail
      // breadcrumb arms the same flag on click; the nav link never does.
      let route = window.location.pathname;
      document.addEventListener('astro:page-load', () => {
        route = window.location.pathname;
      });
      window.addEventListener('popstate', () => {
        if (
          /^\/work\/.+/.test(route) &&
          window.location.pathname.replace(/\/+$/, '') === '/work'
        ) {
          try {
            sessionStorage.setItem('swm:returnToWork', '1');
          } catch {
            /* storage unavailable */
          }
        }
      });
    </script>
  </body>
</html>
