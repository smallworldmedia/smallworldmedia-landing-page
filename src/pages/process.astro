---
/**
 * Process Page — /process (v2 workstream).
 *
 * The sales narrative the work pages assume: one persistent scene morphs
 * through five Stages (Fragment belt → Thread/assembly → light-up →
 * emanation → rhythm) behind a left-anchored copy column, on a normal
 * Lenis document route. The entire interactive surface is a single React
 * island (the index.astro mold) because the island owns the GSAP + scene
 * orchestration. Spec: docs/process-page-spec.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/process.css';
import '../styles/video-globe.css';
import ProcessPage from '../components/process/ProcessPage.jsx';
import { PROCESS_META } from '../components/process/processContent.js';
import { sanityFetch } from '../lib/sanityClient.js';
import { GLOBE_ASSETS_QUERY } from '../lib/queries.js';
import buildAssetPool from '../components/globe/buildAssetPool.js';

// 08-29: launch gate REMOVED (redirect here + netlify.toml 302 + sitemap
// exclude — the planned 3-file un-gate). /process is live.

// The finalized homepage globe now stands in for PROCESS's "O" (B9) — same
// Sanity asset pool the home hero uses.
const globeAssets = buildAssetPool(await sanityFetch(GLOBE_ASSETS_QUERY));
---

<BaseLayout title={PROCESS_META.title} description={PROCESS_META.description}>
  <ProcessPage client:only="react" globeAssets={globeAssets} />
</BaseLayout>
