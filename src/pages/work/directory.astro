---
/**
 * /work/directory — the Project Directory (11-03): every asset on the site as
 * one flush grid under a sticky filter (DirectoryPage). Its props are
 * getDirectoryData(), the build's one directory fetch, which the drawer's
 * Client Roster reads too (BaseLayout), so the two can't disagree. A failed
 * read fails the build here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/directory-grid.css';
import '../../styles/directory.css';
import { getDirectoryData } from '../../lib/directoryData.js';
import DirectoryPage from '../../components/work/directory/DirectoryPage.jsx';

const { tags, clients, tiles, shuffle } = await getDirectoryData();
---

<BaseLayout
  title="Project Directory — Small World Media™"
  description="Every piece of work by Small World Media in one grid, filterable by service and client."
>
  <DirectoryPage client:load tags={tags} clients={clients} tiles={tiles} shuffle={shuffle} />
</BaseLayout>
