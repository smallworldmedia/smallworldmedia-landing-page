---
/**
 * /privacy — plain-language privacy notice. The copy lives in
 * PrivacyContent.jsx (09-08): this route renders it statically for direct
 * links + crawlers; the lower-right privacy pill opens the same content as
 * an in-place overlay (PrivacyOverlay). Styles: global.css `.privacy*`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyContent from '../components/PrivacyContent.jsx';
---

<BaseLayout
  title="Privacy — Small World Media™"
  description="How Small World Media handles your data: no cookies, no tracking, and inquiry-form details used only to reply to you."
>
  <main class="privacy-page">
    <PrivacyContent />
  </main>
</BaseLayout>

<style>
  /* full-bleed black behind the measure; the route's own scroll room */
  :global(body:has(.privacy-page)) {
    background: var(--color-black);
  }
  .privacy-page {
    min-height: 100dvh;
    background: var(--color-black);
  }
</style>
