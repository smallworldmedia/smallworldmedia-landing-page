---
/**
 * /privacy — the privacy policy. The copy lives in PrivacyContent.jsx
 * (09-08): this route renders it statically for direct links + crawlers;
 * the lower-right privacy pill opens the same content as an in-place
 * overlay (PrivacyOverlay). Styles: global.css `.privacy*`, shared with
 * /terms.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyContent from '../components/PrivacyContent.jsx';
---

<BaseLayout
  title="Privacy Policy — Small World Media™"
  description="How Small World Media handles information collected through smallworld.media and from its clients."
>
  <main class="privacy-page">
    <PrivacyContent />
  </main>
</BaseLayout>
