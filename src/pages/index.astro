---
/**
 * Landing Page — SWM homepage.
 *
 * The entire interactive surface is a single React island
 * (client:only="react") because the GSAP orchestration
 * (Flip states, scroll→panel, overlay↔hero) requires
 * a unified React tree.
 *
 * The hero background is the CMS video globe — its asset pool
 * (curated globe picks + breadth-interleaved auto-fill) is
 * fetched from Sanity at build time and passed through the island.
 *
 * Static pages added in the full site build (case studies,
 * about, etc.) will be pure .astro with zero client JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/video-globe.css';
import { sanityFetch } from '../lib/sanityClient.js';
import { GLOBE_ASSETS_QUERY } from '../lib/queries.js';
import buildAssetPool from '../components/globe/buildAssetPool.js';
import LandingPage from '../components/LandingPage.jsx';

const globeAssets = buildAssetPool(await sanityFetch(GLOBE_ASSETS_QUERY));
---

<BaseLayout
  title="Small World Media™ — Visual Worlds for the Music Industry"
  description="Small World Media is a multi-disciplinary creative studio specializing in visual identity, motion design, and digital experiences for the music industry."
>
  <LandingPage client:only="react" globeAssets={globeAssets} />
</BaseLayout>
